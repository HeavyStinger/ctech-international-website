---
import { pxify } from '../lib/style.js';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Header } from '../components/brand/Header.jsx';
import Footer from '../components/brand/Footer.astro';
import Button from '../components/core/Button.astro';
import Card from '../components/core/Card.astro';
import Badge from '../components/core/Badge.astro';
import Eyebrow from '../components/brand/Eyebrow.astro';
import ShimmerHeading from '../components/brand/ShimmerHeading.astro';
import SectionTitle from '../components/brand/SectionTitle.astro';
import ProductSection from '../components/brand/ProductSection.astro';
import TaptCardBenefits from '../components/brand/TaptCardBenefits.astro';
import { withBase } from '../lib/url.js';
import { hubItems, taptFeatures, taptCardBenefits, tesseractFeatures } from '../lib/productContent.js';

const currentPath = Astro.url.pathname;
const wrap = pxify({ width: '100%', maxWidth: 1240, margin: '0 auto', boxSizing: 'border-box', paddingLeft: 'var(--space-7)', paddingRight: 'var(--space-7)' });
const anchor = pxify({ ...wrap, scrollMarginTop: 88 });

const flowChips = [
  { icon: 'credit-card', label: 'Tap the card', sub: 'Tapt' },
  { icon: 'share-2', label: 'Share the link', sub: 'Tesseract' },
];
---

<BaseLayout title="Ctech International | Products"
  description="Tapt NFC smart business cards and Tesseract link-in-bio pages from Ctech International. Tap a phone and your whole presence shows up instantly."
  path="/products">
  <div style={pxify({ background: 'transparent', color: 'var(--text-primary)', fontFamily: 'var(--font-sans)', position: 'relative' })}>
    <Header client:load currentPath={currentPath} />

    <main data-screen-label="Intro" style={pxify({ ...wrap, paddingTop: 'var(--space-9)', paddingBottom: 'var(--space-8)',
      display: 'flex', flexDirection: 'column', gap: 20, alignItems: 'flex-start' })}>
      <Eyebrow>Products</Eyebrow>
      <ShimmerHeading as="h1" size={56}>One tap. One link. Everything.</ShimmerHeading>
      <p style={pxify({ margin: 0, maxWidth: 640, fontSize: 18, lineHeight: 1.6, color: 'var(--text-secondary)' })}>
        Two products we built and run ourselves, designed to work as one system. Tapt gets you
        found in person. Tesseract gets you found online. Both lead to the same place.
      </p>
    </main>

    <div style={pxify({ display: 'flex', flexDirection: 'column', gap: 'var(--space-9)', paddingBottom: 'var(--space-10)' })}>
      <section style={wrap}>
        <SectionTitle title="How they work together" lead="One system, two ways in." />
        <div style={pxify({ marginTop: 40, display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 12, width: '100%' })}>
          <div class="ctech-converge-flow" style={pxify({ display: 'flex', flexWrap: 'wrap', alignItems: 'center', justifyContent: 'center', gap: 20, width: '100%' })}>
            {flowChips.map((c, i) => (
              <Fragment>
                <div style={pxify({ display: 'flex', alignItems: 'center', gap: 16, padding: '18px 26px',
                  border: '1px solid var(--space-border)', borderRadius: 'var(--radius-card)',
                  background: 'var(--glass-tint)' })}>
                  <div style={pxify({ width: 48, height: 48, borderRadius: 'var(--radius-control)', display: 'flex',
                    alignItems: 'center', justifyContent: 'center', flexShrink: 0,
                    background: 'var(--nebula-cyan-10)', border: '1px solid var(--nebula-cyan-30)' })}>
                    <Icon name={`lucide:${c.icon}`} width={22} height={22} style={pxify({ color: 'var(--nebula-cyan)' })} aria-hidden="true" />
                  </div>
                  <div>
                    <div style={pxify({ fontSize: 19, fontWeight: 600 })}>{c.label}</div>
                    {c.sub && <div style={pxify({ fontSize: 14.5, color: 'var(--text-secondary)' })}>{c.sub}</div>}
                  </div>
                </div>
                {i === 0 && <span style={pxify({ fontSize: 16, color: 'var(--text-secondary)', fontWeight: 600 })}>or</span>}
              </Fragment>
            ))}
          </div>

          <Icon name="lucide:arrow-down" width={22} height={22} style={pxify({ color: 'var(--text-secondary)', margin: '6px 0' })} aria-hidden="true" />

          <div style={pxify({ display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 22,
            padding: '20px 44px', maxWidth: 640, width: '100%', boxSizing: 'border-box' })}>
            <div style={pxify({ display: 'flex', alignItems: 'center', gap: 12 })}>
              <Icon name="lucide:zap" width={24} height={24} style={pxify({ color: 'var(--nebula-cyan)' })} aria-hidden="true" />
              <span style={pxify({ fontSize: 21, fontWeight: 600 })}>Your hub</span>
            </div>
            <div style={pxify({ display: 'flex', flexWrap: 'wrap', justifyContent: 'center', gap: 16 })}>
              {hubItems.map((item, i) => (
                <Badge variant="neutral" style={pxify({ fontSize: 14, padding: '6px 14px',
                  animation: `ctech-float ${4 + (i % 3) * 0.7}s ease-in-out infinite`, animationDelay: `${-(i * 0.5)}s` })}>
                  {item}
                </Badge>
              ))}
            </div>
          </div>

          <div style={pxify({ marginTop: 24, display: 'flex', flexWrap: 'wrap', justifyContent: 'center', gap: 32, maxWidth: 820 })}>
            <div style={pxify({ display: 'flex', alignItems: 'center', gap: 12, maxWidth: 400 })}>
              <Icon name="lucide:refresh-cw" width={20} height={20} style={pxify({ color: 'var(--nebula-cyan)', flexShrink: 0 })} aria-hidden="true" />
              <span style={pxify({ fontSize: 16, color: 'var(--text-secondary)', lineHeight: 1.5 })}>
                Point the card anywhere, anytime. Change its destination from the Tapt dashboard, no new hardware needed.
              </span>
            </div>
            <div style={pxify({ display: 'flex', alignItems: 'center', gap: 12, maxWidth: 340 })}>
              <Icon name="lucide:bar-chart-3" width={20} height={20} style={pxify({ color: 'var(--nebula-cyan)', flexShrink: 0 })} aria-hidden="true" />
              <span style={pxify({ fontSize: 16, color: 'var(--text-secondary)', lineHeight: 1.5 })}>
                Every tap is tracked, so you can see how it’s actually being used.
              </span>
            </div>
          </div>
        </div>
      </section>

      <section id="tapt" style={anchor}>
        <SectionTitle title="Tapt" lead="Your presence in person. Tap the card, and everything’s right there." />
        <TaptCardBenefits groups={taptCardBenefits} />
        <ProductSection icon="credit-card" eyebrow="SMART CARDS" name="Tapt" flameWrap
          tagline="No more paper cards that get lost or thrown out. Buy one card or a full set and mix and match by type. Tap a phone against any of them and your whole presence shows up instantly, contact included."
          typesLabel="Card Types" types={['Business', 'Google Review', 'Menu', 'WiFi QR', 'Custom']}
          features={taptFeatures} detailsHref={withBase('/products/tapt')}>
          <Fragment slot="media">
            <iframe
              src="https://www.youtube.com/embed/5TdNEBiGkLA"
              title="Tapt demo"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              style={pxify({ width: '100%', aspectRatio: '9 / 16', border: '1px solid var(--space-border)',
                borderRadius: 'var(--radius-card)', display: 'block' })}
            ></iframe>
          </Fragment>
        </ProductSection>
      </section>

      <section id="tesseract" style={anchor}>
        <SectionTitle title="Tesseract" lead="Your presence online. One link, everything behind it." />
        <ProductSection icon="link-2" eyebrow="LINK IN BIO" name="Tesseract"
          tagline="Instead of a cluttered link-in-bio page, one clean link holds your contact, reviews, menu, socials, and booking, all in one place."
          features={tesseractFeatures} detailsHref={withBase('/products/tesseract')}>
          <Fragment slot="media">
            <iframe
              src="https://www.youtube.com/embed/tRzfYxVaCxs"
              title="Tesseract demo"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              style={pxify({ width: '100%', aspectRatio: '9 / 16', border: '1px solid var(--space-border)',
                borderRadius: 'var(--radius-card)', display: 'block' })}
            ></iframe>
          </Fragment>
        </ProductSection>
      </section>

      <section style={wrap}>
        <SectionTitle title="Pricing" />
        <div style={pxify({ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(min(340px, 100%), 1fr))', gap: 24, marginTop: 36 })}>
          <div class="ctech-flame-wrap" data-flame-wrap style={pxify({ position: 'relative', zIndex: 1, height: '100%' })}>
            <canvas class="ctech-flame-source" aria-hidden="true" style={pxify({ position: 'absolute', top: 0, left: 0, width: '100%', height: '100%', opacity: 0, pointerEvents: 'none' })}></canvas>
            <canvas class="ctech-flame-output" aria-hidden="true" style={pxify({ position: 'absolute', top: -190, left: -24, width: 'calc(100% + 48px)', height: 'calc(100% + 210px)', pointerEvents: 'none' })}></canvas>
            <div class="ctech-flame-content" style={pxify({ position: 'relative', height: '100%' })}>
          <Card padding={32} glow style={pxify({ display: 'flex', flexDirection: 'column', height: '100%' })}>
            <div style={pxify({ display: 'flex', justifyContent: 'space-between', alignItems: 'baseline', gap: 12 })}>
              <div style={pxify({ fontSize: 22, fontWeight: 600 })}>Tapt</div>
              <div style={pxify({ fontSize: 13, letterSpacing: '0.06em', color: 'var(--nebula-cyan)' })}>SMART CARDS</div>
            </div>
            <div style={pxify({ marginTop: 3, display: 'flex', flexDirection: 'column', gap: 4 })}>
              <span style={pxify({ fontSize: 13, lineHeight: 1, color: 'var(--text-secondary)' })}>Business or Review card</span>
              <div style={pxify({ display: 'flex', alignItems: 'baseline', gap: 8 })}>
                <span style={pxify({ fontSize: 44, fontWeight: 700, lineHeight: 1 })}>150 BZD</span>
                <span style={pxify({ fontSize: 15, color: 'var(--text-secondary)' })}>/year</span>
              </div>
            </div>
            <Badge variant="cyan" style={pxify({ marginTop: 12, alignSelf: 'flex-start' })}>Includes your hub</Badge>
            <div style={pxify({ fontSize: 14, color: 'var(--text-secondary)', marginTop: 10 })}>+50 BZD/year for each extra card. Menu cards are custom quoted.</div>
            <div style={pxify({ height: 1, background: 'var(--space-border)', margin: '24px 0' })} />
            <div style={pxify({ display: 'flex', flexDirection: 'column', gap: 12, fontSize: 15, lineHeight: 1.5 })}>
              <div style={pxify({ display: 'flex', gap: 10 })}><Icon name="lucide:check" width={15} height={15} style={pxify({ marginTop: 3, flexShrink: 0, color: 'var(--nebula-cyan)' })} aria-hidden="true" /><span>Business card hub: your Tesseract page, contact, socials, and everything else in one tap</span></div>
              <div style={pxify({ display: 'flex', gap: 10 })}><Icon name="lucide:check" width={15} height={15} style={pxify({ marginTop: 3, flexShrink: 0, color: 'var(--nebula-cyan)' })} aria-hidden="true" /><span>Google review hub: a Review vs Feedback page, happy customers go straight to a 5-star review, everyone else is routed to private feedback instead</span></div>
              <div style={pxify({ display: 'flex', gap: 10 })}><Icon name="lucide:check" width={15} height={15} style={pxify({ marginTop: 3, flexShrink: 0, color: 'var(--nebula-cyan)' })} aria-hidden="true" /><span>Menu hub: a live editor you control, edit anytime and it goes live the instant you save, priced with a custom quote</span></div>
              <div style={pxify({ display: 'flex', gap: 10 })}><Icon name="lucide:check" width={15} height={15} style={pxify({ marginTop: 3, flexShrink: 0, color: 'var(--nebula-cyan)' })} aria-hidden="true" /><span>Business and Google Review cards, 150 BZD/year each</span></div>
              <div style={pxify({ display: 'flex', gap: 10 })}><Icon name="lucide:check" width={15} height={15} style={pxify({ marginTop: 3, flexShrink: 0, color: 'var(--nebula-cyan)' })} aria-hidden="true" /><span>WiFi QR auto-connect codes, 50 BZD one-time</span></div>
            </div>
            <p style={pxify({ fontSize: 13, color: 'var(--text-secondary)', marginTop: 20, lineHeight: 1.5 })}>
              Business and Google Review cards are 150 BZD/year each, with each additional card after your first at 50 BZD/year. Menu cards are priced with a custom quote. Ask us about deals for larger orders.
            </p>
            <div class="ctech-card-actions" style={pxify({ marginTop: 'auto', paddingTop: 20, display: 'flex', gap: 10, flexWrap: 'wrap' })}>
              <Button href={`${withBase('/contact')}?service=tapt-cards#form`} variant="primary" size="sm" style={pxify({ width: '100%' })}>Ask for a Quote</Button>
              <Button href={withBase('/products/tapt')} variant="secondary" size="sm" style={pxify({ width: '100%' })}>View Full Product</Button>
            </div>
          </Card>
            </div>
          </div>

          <Card padding={32} style={pxify({ display: 'flex', flexDirection: 'column', height: '100%' })}>
            <div style={pxify({ display: 'flex', justifyContent: 'space-between', alignItems: 'baseline', gap: 12 })}>
              <div style={pxify({ fontSize: 22, fontWeight: 600 })}>Tesseract</div>
              <div style={pxify({ fontSize: 13, letterSpacing: '0.06em', color: 'var(--text-secondary)' })}>LINK IN BIO</div>
            </div>
            <div style={pxify({ marginTop: 20, display: 'flex', alignItems: 'baseline', gap: 8 })}>
              <span style={pxify({ fontSize: 44, fontWeight: 700, lineHeight: 1 })}>100 BZD</span>
              <span style={pxify({ fontSize: 15, color: 'var(--text-secondary)' })}>/year</span>
            </div>
            <div style={pxify({ fontSize: 14, color: 'var(--text-secondary)', marginTop: 6 })}>Just the link, no physical card</div>
            <div style={pxify({ height: 1, background: 'var(--space-border)', margin: '24px 0' })} />
            <div style={pxify({ display: 'flex', flexDirection: 'column', gap: 12, fontSize: 15, lineHeight: 1.5 })}>
              <div style={pxify({ display: 'flex', gap: 10 })}><Icon name="lucide:check" width={15} height={15} style={pxify({ marginTop: 3, flexShrink: 0, color: 'var(--nebula-cyan)' })} aria-hidden="true" /><span>Easy-to-use profile editor, update it yourself anytime</span></div>
              <div style={pxify({ display: 'flex', gap: 10 })}><Icon name="lucide:check" width={15} height={15} style={pxify({ marginTop: 3, flexShrink: 0, color: 'var(--nebula-cyan)' })} aria-hidden="true" /><span>Analytics included, see who’s tapping and clicking</span></div>
              <div style={pxify({ display: 'flex', gap: 10 })}><Icon name="lucide:check" width={15} height={15} style={pxify({ marginTop: 3, flexShrink: 0, color: 'var(--nebula-cyan)' })} aria-hidden="true" /><span>QR code included, print it anywhere and link straight to your page</span></div>
              <div style={pxify({ display: 'flex', gap: 10 })}><Icon name="lucide:check" width={15} height={15} style={pxify({ marginTop: 3, flexShrink: 0, color: 'var(--nebula-cyan)' })} aria-hidden="true" /><span>Put it in your bio, one link for everything you share</span></div>
              <div style={pxify({ display: 'flex', gap: 10 })}><Icon name="lucide:check" width={15} height={15} style={pxify({ marginTop: 3, flexShrink: 0, color: 'var(--nebula-cyan)' })} aria-hidden="true" /><span>Save Contact button built in, one tap and you’re in their phone</span></div>
              <div style={pxify({ display: 'flex', gap: 10 })}><Icon name="lucide:check" width={15} height={15} style={pxify({ marginTop: 3, flexShrink: 0, color: 'var(--nebula-cyan)' })} aria-hidden="true" /><span>Hand-picked templates included, or a custom template for 50 BZD extra, one-time</span></div>
            </div>
            <p style={pxify({ fontSize: 13, color: 'var(--text-secondary)', marginTop: 20, lineHeight: 1.5 })}>
              Already getting a Tapt business card? This is included, no need to buy it separately.
            </p>
            <div class="ctech-card-actions" style={pxify({ marginTop: 'auto', paddingTop: 20, display: 'flex', gap: 10, flexWrap: 'wrap' })}>
              <Button href={`${withBase('/contact')}?service=tesseract#form`} variant="secondary" size="sm" style={pxify({ width: '100%' })}>Get Tesseract</Button>
              <Button href={withBase('/products/tesseract')} variant="ghost" size="sm" style={pxify({ width: '100%' })}>View Full Product</Button>
            </div>
          </Card>
        </div>
      </section>

      <section data-screen-label="Consultation CTA" style={wrap}>
        <div style={pxify({ border: '1px solid var(--nebula-cyan-30)', borderRadius: 'var(--radius-card)',
          boxShadow: 'var(--glow-cyan-soft), var(--glass-highlight)', background: 'var(--glass-bg)',
          backdropFilter: 'var(--glass-blur)', WebkitBackdropFilter: 'var(--glass-blur)',
          padding: '72px var(--space-7)', display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 18, textAlign: 'center' })}>
          <h2 style={pxify({ margin: 0, fontSize: 36, fontWeight: 600, lineHeight: 1.1, textWrap: 'balance' })}>Have questions about Tapt or Tesseract?</h2>
          <p style={pxify({ margin: 0, fontSize: 16, lineHeight: 1.6, color: 'var(--text-secondary)' })}>A 20-minute call is all it takes.</p>
          <div style={pxify({ marginTop: 10 })}>
            <Button href={`${withBase('/contact')}#form`} variant="primary" size="lg">Book a Consultation</Button>
          </div>
        </div>
      </section>
    </div>

    <Footer currentPath={currentPath} />
  </div>
</BaseLayout>

<script>
  import '../lib/flameWrap.client.js';
</script>
