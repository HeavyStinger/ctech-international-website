---
import { pxify } from '../../lib/style.js';
// Static (hover-only) counterpart to Card.jsx. Handles the `interactive`
// hover-lift + `glow` treatments via CSS. The one card that also needs a
// click handler (Portfolio's card grid opening a lightbox) lives inside its
// own small React island and wraps this visual in a native <button>, so no
// click/keyboard-activation logic needs to live here.
const { interactive = false, glow = false, padding = 24, style, class: className, ...rest } = Astro.props;
---

<div class:list={['ctech-card', interactive && 'ctech-card-interactive', className]}
  style={pxify({ background: 'var(--glass-bg)',
    backdropFilter: 'var(--glass-blur)', WebkitBackdropFilter: 'var(--glass-blur)',
    border: '1px solid var(--glass-border)',
    borderRadius: 'var(--radius-card)', padding,
    boxShadow: (glow ? 'var(--glow-cyan-soft), ' : '') + 'var(--glass-highlight)',
    cursor: interactive ? 'pointer' : 'default',
    transform: 'translateY(0)',
    transition: 'transform 300ms var(--ease-hud), background 300ms var(--ease-hud), border-color 300ms var(--ease-hud), box-shadow 300ms var(--ease-hud)',
    fontFamily: 'var(--font-sans)', color: 'var(--text-primary)', ...style })}
  {...rest}><slot /></div>

<style>
  .ctech-card-interactive:hover {
    background: var(--glass-bg-hover);
    border-color: var(--nebula-cyan-30);
    box-shadow: var(--glow-cyan-soft), var(--glass-highlight);
    transform: translateY(-3px);
  }
</style>
