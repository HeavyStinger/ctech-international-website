---
import { pxify } from '../../lib/style.js';
const { title, lead } = Astro.props;
---

<div style={pxify({ display: 'flex', flexDirection: 'column', gap: 14, maxWidth: 680 })}>
  <div style={pxify({ width: 40, height: 2, background: 'var(--nebula-cyan)', boxShadow: '0 0 12px rgba(0,204,255,0.6)' })} />
  <h2 style={pxify({ margin: 0, fontSize: 36, fontWeight: 600, lineHeight: 1.1, textWrap: 'balance' })}>{title}</h2>
  {lead && <p style={pxify({ margin: 0, fontSize: 17, lineHeight: 1.6, color: 'var(--text-secondary)' })}>{lead}</p>}
</div>
