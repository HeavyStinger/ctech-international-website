---
import { pxify } from '../../lib/style.js';
// Deterministic scattered star-points. Parent must be position:relative.
const { count = 24, seed = 7, opacity = 0.35, style } = Astro.props;

let s = seed;
const rnd = () => { s = (s * 16807) % 2147483647; return s / 2147483647; };
const stars = Array.from({ length: count }, (_, i) => ({
  id: i, x: rnd() * 100, y: rnd() * 100,
  r: 0.75 + rnd() * 1.25, o: 0.4 + rnd() * 0.6,
}));
---

<svg aria-hidden="true" width="100%" height="100%" preserveAspectRatio="none"
  style={pxify({ position: 'absolute', inset: 0, pointerEvents: 'none', opacity, ...style })}>
  {stars.map((st) => (
    <circle cx={st.x + '%'} cy={st.y + '%'} r={st.r} fill="#F8FAFC" opacity={st.o} />
  ))}
</svg>
